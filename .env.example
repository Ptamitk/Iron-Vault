# Copy to .env.local for local work. Never commit real keys.

# Browser-side (safe to expose): 'demo' (default in dev) | 'razorpay' | leave empty to turn online payment off
VITE_PAYMENT_MODE=demo
# Only if the API runs on another domain than the site, e.g. https://api.example.com
VITE_API_BASE=

# Server-side ONLY (set these in your host's dashboard, not in the repo):
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
