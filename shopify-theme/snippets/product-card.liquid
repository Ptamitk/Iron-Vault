<article class="product-card"><a class="product-card-image" href="{{ card_product.url }}">{% if card_product.featured_image %}{{ card_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: card_product.title }}{% else %}<span class="image-placeholder">IRON VAULT</span>{% endif %}{% unless card_product.available %}<span class="product-badge">SOLD OUT</span>{% endunless %}</a><div class="product-card-meta"><span>{{ card_product.vendor | escape }}</span><span>{{ card_product.type | escape }}</span></div><a class="product-card-title" href="{{ card_product.url }}">{{ card_product.title | escape }}</a><div class="product-card-bottom"><span>{% render 'price', product: card_product %}</span><a href="{{ card_product.url }}">VIEW ↗</a></div></article>