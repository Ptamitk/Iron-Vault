<section class="product-page section-light"><nav class="breadcrumbs"><a href="{{ routes.all_products_collection_url }}">SHOP</a><span>/</span><span>{{ product.title | escape }}</span></nav><div class="product-layout"><div class="product-gallery">{% for media in product.media %}{% if media.media_type == 'image' %}<div class="product-gallery-image">{{ media | image_url: width: 1400 | image_tag: loading: 'lazy', alt: media.alt | default: product.title }}</div>{% endif %}{% endfor %}</div><div class="product-information">{% if section.settings.show_vendor %}<p class="eyebrow"><span></span>{{ product.vendor | escape }}</p>{% endif %}<h1 class="display">{{ product.title | escape }}</h1><div class="product-price">{% render 'price', product: product %}</div>{% if section.settings.show_description %}<div class="rte product-description">{{ product.description }}</div>{% endif %}{% form 'product', product, class: 'product-form' %}{% unless product.has_only_default_variant %}<label for="VariantSelect">OPTIONS</label><select id="VariantSelect" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — SOLD OUT{% endunless %}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}<label for="Quantity">QUANTITY</label><input id="Quantity" type="number" name="quantity" value="1" min="1" max="99"><button class="iv-button add-to-cart" type="submit" name="add" {% unless product.available %}disabled{% endunless %}>{% if product.available %}ADD TO BAG{% else %}SOLD OUT{% endif %}</button>{{ form | payment_button }}{% endform %}<div class="product-accordions"><details><summary>PRODUCT DETAILS</summary><div class="rte">{{ product.description }}</div></details><details><summary>SHIPPING & RETURNS</summary><p>Shipping options and delivery estimates are calculated during Shopify checkout based on your address.</p></details></div></div></div></section>{% schema %}{"name":"Main product","settings":[{"type":"checkbox","id":"show_vendor","label":"Show vendor","default":true},{"type":"checkbox","id":"show_description","label":"Show description","default":true}]}{% endschema %}