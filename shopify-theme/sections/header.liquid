<div class="announcement">{{ settings.announcement_text | escape }}</div>

<header class="site-header">
  <a class="brand-mark" href="{{ routes.root_url }}" aria-label="IRON VAULT home">IRON<span>VAULT</span><i></i></a>

  <nav class="desktop-nav" aria-label="Shop categories">
    <a class="nav-home" href="{{ routes.root_url }}">HOME</a>
    <a href="/collections/peptides">PEPTIDES</a>
    <a href="/collections/supplements">SUPPLEMENTS</a>
    <a href="/collections/clothing">CLOTHING</a>
    <a href="/collections/accessories">ACCESSORIES</a>
  </nav>

  <div class="header-actions">
    <a class="header-search" href="{{ routes.search_url }}" aria-label="Search">SEARCH</a>
    <a class="header-account" href="{{ routes.account_url }}" aria-label="Account">ACCOUNT</a>
    <a class="cart-link" href="{{ routes.cart_url }}" aria-label="Shopping bag">BAG <span>{{ cart.item_count }}</span></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="MobileNav" aria-label="Open menu">
      <span></span><span></span>
    </button>
  </div>
</header>

<nav id="MobileNav" class="mobile-nav" aria-label="Mobile navigation" hidden>
  <a href="{{ routes.root_url }}">HOME</a>
  <a href="/collections/peptides">PEPTIDES</a>
  <a href="/collections/supplements">SUPPLEMENTS</a>
  <a href="/collections/clothing">CLOTHING</a>
  <a href="/collections/accessories">ACCESSORIES</a>
  <div class="mobile-nav-utilities">
    <a href="{{ routes.search_url }}">SEARCH</a>
    <a href="{{ routes.account_url }}">ACCOUNT</a>
    <a href="{{ routes.cart_url }}">BAG ({{ cart.item_count }})</a>
  </div>
</nav>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
