<section class="iv-featured section-light"><div class="section-heading"><div><p class="eyebrow"><span></span>{{ section.settings.eyebrow | escape }}</p><h2 class="display">{{ section.settings.heading | escape }}</h2></div>{% if section.settings.show_view_all and section.settings.collection != blank %}<a class="text-link" href="{{ section.settings.collection.url }}">VIEW ALL ↗</a>{% endif %}</div>{% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}<div class="product-grid">{% for product in section.settings.collection.products limit: section.settings.products_to_show %}{% render 'product-card', card_product: product %}{% endfor %}</div>{% else %}<p class="empty-state">Select a collection in this section's settings to display products.</p>{% endif %}</section>{% schema %}{"name":"Featured collection","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE RANGE"},{"type":"text","id":"heading","label":"Heading","default":"BUILT FOR EVERY GOAL"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","label":"Products to show","min":4,"max":16,"step":4,"default":8},{"type":"checkbox","id":"show_view_all","label":"Show view all","default":true}],"presets":[{"name":"Featured collection"}]}{% endschema %}