<section class="trust-strip"><div class="trust-heading"><p class="eyebrow"><span></span>THE IRON VAULT STANDARD</p><h2 class="display">{{ section.settings.heading | escape }}</h2></div><div class="trust-grid">{% for n in (1..4) %}{% capture title_key %}item_{{ n }}_title{% endcapture %}{% capture text_key %}item_{{ n }}_text{% endcapture %}<article><b>0{{ n }}</b><h3>{{ section.settings[title_key] | escape }}</h3><p>{{ section.settings[text_key] | escape }}</p></article>{% endfor %}</div></section>{% schema %}{"name":"Trust strip","settings":[{"type":"text","id":"heading","label":"Heading","default":"BUILT ON TRANSPARENCY"},{"type":"text","id":"item_one_title","label":"Item 1 title","default":"INGREDIENTS UP FRONT"},{"type":"textarea","id":"item_one_text","label":"Item 1 text","default":"Supplement facts, suggested use and warnings on every product page."},{"type":"text","id":"item_two_title","label":"Item 2 title","default":"TRUSTED BRANDS"},{"type":"textarea","id":"item_two_text","label":"Item 2 text","default":"International performance nutrition brands, clearly labelled."},{"type":"text","id":"item_three_title","label":"Item 3 title","default":"DELIVERED ACROSS INDIA"},{"type":"textarea","id":"item_three_text","label":"Item 3 text","default":"Pan-India delivery options shown at checkout."},{"type":"text","id":"item_four_title","label":"Item 4 title","default":"SECURE CHECKOUT"},{"type":"textarea","id":"item_four_text","label":"Item 4 text","default":"Checkout and order updates managed by Shopify."}],"presets":[{"name":"Trust strip"}]}{% endschema %}