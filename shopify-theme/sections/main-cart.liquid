<section class="cart-page section-light"><p class="eyebrow"><span></span>YOUR SELECTION</p><h1 class="display">SHOPPING BAG</h1>{% if cart.item_count == 0 %}<div class="empty-cart"><p>Your bag is waiting for something good.</p><a class="iv-button" href="{{ routes.all_products_collection_url }}">SHOP ALL ↗</a></div>{% else %}<form action="{{ routes.cart_url }}" method="post" novalidate><div class="cart-lines">{% for item in cart.items %}<article class="cart-line">{% if item.image %}<a href="{{ item.url }}">{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.title }}</a>{% endif %}<div><a class="cart-line-title" href="{{ item.url }}">{{ item.product.title | escape }}</a><p>{{ item.variant.title }}</p><label for="updates_{{ item.key }}">QTY</label><input id="updates_{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0"></div><strong>{{ item.final_line_price | money }}</strong></article>{% endfor %}</div><div class="cart-summary"><p>Subtotal <strong>{{ cart.total_price | money }}</strong></p><p class="cart-note">Shipping, discounts and taxes are calculated at checkout.</p><button class="iv-button iv-button-ghost" type="submit" name="update">UPDATE BAG</button><button class="iv-button" type="submit" name="checkout">CHECKOUT ↗</button></div></form>{% endif %}</section>{% schema %}{"name":"Main cart","settings":[]} {% endschema %}