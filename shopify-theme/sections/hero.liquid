{% comment %}IRON VAULT split-screen launch hero. The selected Shopify Files image is the persistent source for the athlete photograph.{% endcomment %}
<section class="iv-hero iv-hero--split" aria-labelledby="HeroHeading-{{ section.id }}">
  <div class="iv-hero__photo">
    {% if section.settings.athlete_image != blank %}
      {{ section.settings.athlete_image | image_url: width: 1800 | image_tag: class: 'iv-hero__athlete', loading: 'eager', fetchpriority: 'high', widths: '480, 720, 960, 1200, 1600, 1800', sizes: '(min-width: 981px) 50vw, 100vw', alt: 'IRON VAULT athlete' }}
    {% else %}
      <img class="iv-hero__athlete" src="{{ 'iron-vault-athlete-hero.jpg' | file_url }}" alt="IRON VAULT athlete" width="728" height="600" loading="eager" fetchpriority="high">
    {% endif %}
    <span class="iv-hero__photo-shade" aria-hidden="true"></span>
    <span class="iv-hero__photo-index" aria-hidden="true">IV / 01</span>
  </div>

  <div class="iv-hero__content">
    <div class="iv-hero__content-inner">
      <p class="iv-hero__eyebrow"><span></span>{{ section.settings.eyebrow | escape }}</p>
      <div class="iv-hero__wordmark" aria-label="IRON VAULT">
        <span>IRON<span class="iv-hero__wordmark-accent">VAULT</span></span>
        <small>SPORTS NUTRITION MARKETPLACE</small>
      </div>
      <h1 id="HeroHeading-{{ section.id }}" class="display iv-hero__heading">
        {% assign heading_lines = section.settings.heading | newline_to_br | split: '<br />' %}
        {% for line in heading_lines %}
          <span class="iv-hero__heading-line{% if forloop.last %} iv-hero__heading-line--accent{% endif %}">{{ line | strip | escape }}</span>
        {% endfor %}
      </h1>
      {% if section.settings.subheading != blank %}
        <p class="iv-hero__subheading">{{ section.settings.subheading | escape }}</p>
      {% endif %}
      <div class="iv-hero__actions">
        <a class="iv-button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></a>
        {% if section.settings.secondary_label != blank %}
          <a class="iv-hero__secondary" href="{{ section.settings.secondary_link | default: routes.all_products_collection_url }}">{{ section.settings.secondary_label | escape }}</a>
        {% endif %}
      </div>
      <div class="iv-hero__proof">
        <div><span class="iv-hero__proof-icon">◇</span><b>{{ section.settings.proof_one_title | escape }}</b><small>{{ section.settings.proof_one_text | escape }}</small></div>
        <div><span class="iv-hero__proof-icon">⬡</span><b>{{ section.settings.proof_two_title | escape }}</b><small>{{ section.settings.proof_two_text | escape }}</small></div>
        <div><span class="iv-hero__proof-icon">↠</span><b>{{ section.settings.proof_three_title | escape }}</b><small>{{ section.settings.proof_three_text | escape }}</small></div>
      </div>
    </div>
    <span class="iv-hero__corner-mark" aria-hidden="true">IV.</span>
  </div>
</section>

{% schema %}
{
  "name": "IRON VAULT hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "PERFORMANCE. PRECISION. POWER." },
    { "type": "image_picker", "id": "athlete_image", "label": "Athlete photograph" },
    { "type": "textarea", "id": "heading", "label": "Main heading (one line per row)", "default": "THE VAULT IS OPEN\nBUILT FOR MORE" },
    { "type": "textarea", "id": "subheading", "label": "Description", "default": "India's premium sports nutrition marketplace. Discover trusted international brands, authentic products and performance-focused essentials." },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "EXPLORE THE VAULT" },
    { "type": "url", "id": "button_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary link label", "default": "DISCOVER OUR STORY" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "text", "id": "proof_one_title", "label": "Proof point 1 title", "default": "AUTHENTICITY" },
    { "type": "text", "id": "proof_one_text", "label": "Proof point 1 text", "default": "FIRST SOURCING" },
    { "type": "text", "id": "proof_two_title", "label": "Proof point 2 title", "default": "MULTI-BRAND" },
    { "type": "text", "id": "proof_two_text", "label": "Proof point 2 text", "default": "ONE DESTINATION" },
    { "type": "text", "id": "proof_three_title", "label": "Proof point 3 title", "default": "PAN-INDIA" },
    { "type": "text", "id": "proof_three_text", "label": "Proof point 3 text", "default": "DELIVERY" }
  ],
  "presets": [{ "name": "IRON VAULT hero" }]
}
{% endschema %}
