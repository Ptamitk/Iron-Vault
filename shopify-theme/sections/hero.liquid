<section class="iv-hero"><div class="hero-copy"><p class="eyebrow"><span></span>{{ section.settings.eyebrow | escape }}</p><h1 class="display hero-heading">{% assign words = section.settings.heading | newline_to_br | split: '<br />' %}{% for word in words %}<span class="{% cycle 'solid','outline','accent','solid' %}">{{ word | escape }}</span>{% endfor %}</h1></div><div class="hero-visual">{% if section.settings.athlete_image != blank %}<div class="hero-athlete">{{ section.settings.athlete_image | image_url: width: 1200 | image_tag: loading: 'eager', alt: section.settings.athlete_image.alt }}</div>{% endif %}{% assign hero_product = section.settings.hero_product %}{% if hero_product != blank %}<a class="hero-product" href="{{ hero_product.url }}">{{ hero_product.featured_image | image_url: width: 1000 | image_tag: loading: 'eager', alt: hero_product.title }}<span class="hero-product-tag">{{ hero_product.vendor | escape }}<b>{{ hero_product.title | escape }}</b></span></a>{% elsif section.settings.product_image != blank %}<div class="hero-product">{{ section.settings.product_image | image_url: width: 1000 | image_tag: loading: 'eager' }}</div>{% else %}<div class="hero-product hero-placeholder">IRON<br>VAULT</div>{% endif %}</div><div class="hero-bottom"><div><p class="hero-sub">{{ section.settings.subheading | escape }}</p><div class="hero-buttons"><a class="iv-button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }} ↗</a>{% if section.settings.secondary_label != blank %}<a class="iv-button iv-button-ghost" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }}</a>{% endif %}</div></div><dl class="hero-stats"><div><dt>{{ section.settings.stat_one_label }}</dt><dd>{{ section.settings.stat_one_value }}</dd></div><div><dt>{{ section.settings.stat_two_label }}</dt><dd>{{ section.settings.stat_two_value }}</dd></div><div><dt>{{ section.settings.stat_three_label }}</dt><dd>{{ section.settings.stat_three_value }}</dd></div></dl></div></section>{% schema %}{"name":"IRON VAULT hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"PERFORMANCE NUTRITION"},{"type":"textarea","id":"heading","label":"Heading (one line per row)","default":"TRAIN.\nFUEL.\nRECOVER.\nREPEAT."},{"type":"image_picker","id":"athlete_image","label":"Athlete image"},{"type":"product","id":"hero_product","label":"Featured product"},{"type":"image_picker","id":"product_image","label":"Fallback product image"},{"type":"textarea","id":"subheading","label":"Description","default":"Performance supplements from trusted international brands, with every ingredient listed up front. Pick your goal and shop it in a minute."},{"type":"text","id":"button_label","label":"Primary button","default":"SHOP NOW"},{"type":"url","id":"button_link","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary button","default":"SHOP PROTEIN"},{"type":"url","id":"secondary_link","label":"Secondary link"},{"type":"text","id":"stat_one_label","label":"Stat 1 label","default":"PRODUCTS"},{"type":"text","id":"stat_one_value","label":"Stat 1 value","default":"50+"},{"type":"text","id":"stat_two_label","label":"Stat 2 label","default":"PARTNER BRANDS"},{"type":"text","id":"stat_two_value","label":"Stat 2 value","default":"10+"},{"type":"text","id":"stat_three_label","label":"Stat 3 label","default":"FREE SHIPPING"},{"type":"text","id":"stat_three_value","label":"Stat 3 value","default":"₹4,999+"}],"presets":[{"name":"IRON VAULT hero"}]}{% endschema %}