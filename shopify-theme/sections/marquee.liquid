<div class="iv-marquee"><div class="marquee-track">{% for i in (1..2) %}<div class="marquee-set">{% assign words = section.settings.items | split: '•' %}{% for word in words %}<span>{{ word | strip | escape }} <i></i></span>{% endfor %}</div>{% endfor %}</div></div>{% schema %}{"name":"Ticker marquee","settings":[{"type":"text","id":"items","label":"Ticker text separated by •","default":"PRE-WORKOUT • PROTEIN • CREATINE • HYDRATION • AMINO ACIDS • WELLNESS"}],"presets":[{"name":"Ticker marquee"}]}{% endschema %}