<section class="iv-faq section-light"><h2 class="display">{{ section.settings.heading | escape }}</h2><div class="faq-list">{% for block in section.blocks %}<details class="faq-item" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}<span>+</span></summary><div class="faq-answer">{{ block.settings.answer }}</div></details>{% endfor %}</div></section>{% schema %}{"name":"FAQ","settings":[{"type":"text","id":"heading","label":"Heading","default":"QUESTIONS, ANSWERED"}],"blocks":[{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"Are the products genuine?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Product sourcing and authenticity information should be confirmed with the store before launch.</p>"}]}],"presets":[{"name":"FAQ","blocks":[{"type":"question"},{"type":"question"},{"type":"question"}]}]}{% endschema %}