<section class="collection-page section-light"><header class="collection-header"><p class="eyebrow"><span></span>FIND YOUR FUEL</p><h1 class="display">SEARCH</h1></header><form action="{{ routes.search_url }}" method="get" role="search" class="search-form"><label class="visually-hidden" for="SearchInput">Search products</label><input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products, brands and categories"><input type="hidden" name="options[prefix]" value="last"><button class="iv-button" type="submit">SEARCH ↗</button></form>{% if search.performed %}<p class="search-count">{{ search.results_count }} RESULTS FOR “{{ search.terms | escape }}”</p><div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', card_product: item %}{% endif %}{% endfor %}</div>{% endif %}</section>{% schema %}{"name":"Main search","settings":[]} {% endschema %}